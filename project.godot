; Engine configuration file.
; Ashen Saga — Viking Age survivors RPG (Godot 4.x, Android-first).

config_version=5

[application]

config/name="Ashen Saga"
config/description="Viking Age survivors RPG: Eirik Ash-Hand hunts the Sunstone across 3 acts."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
; orientation 1 = landscape (phone held sideways; arena + touch controls need width)

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; gl_compatibility keeps the Android export working on the widest range of phones.
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
